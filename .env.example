# ==================================================
# TELEGRAM API CREDENTIALS
# ==================================================
# Get your API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# ==================================================
# CHANNEL SETTINGS
# ==================================================
# Source Channels - Where arbitrage bets are posted
# Use format: @channelname or -1001234567890 (channel ID)
# For MULTIPLE channels, separate with commas:
# Example: @channel1,@channel2,@channel3
SOURCE_CHANNEL_ID=@source_channel_username

# Target Channel - Your channel where you want to post
# You must be admin with posting rights
TARGET_CHANNEL_ID=@your_channel_username

# ==================================================
# SESSION SETTINGS
# ==================================================
SESSION_NAME=arbitrage_forwarder

# ==================================================
# FILTERING OPTIONS (Optional)
# ==================================================
# Minimum profit percentage to forward
MIN_PROFIT_THRESHOLD=0

# Comma-separated keywords (leave empty to disable)
REQUIRED_KEYWORDS=
EXCLUDED_KEYWORDS=
